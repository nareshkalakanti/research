# Copy to .env.local (never commit .env.local)

# LLM — local Ollama is the usual setup
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Cloud LLMs (optional; used when LLM_PROVIDER=openai|anthropic|auto)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Firecrawl — PDF/DOCX parse for concalls and investor materials
# https://docs.firecrawl.dev/features/parse
FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=https://api.firecrawl.dev
# FIRECRAWL_MAX_PAGES=80
# FIRECRAWL_PDF_MODE=auto   # auto | fast | ocr

# Corporate data — scanned PDFs (page images → vision OCR)
# On Mac: use Ollama vision (vLLM is Linux+NVIDIA only)
#   ollama pull qwen2.5vl:3b
# QIANFAN_OCR_BASE_URL=http://127.0.0.1:11434/v1
# QIANFAN_OCR_MODEL=qwen2.5vl:3b
# Prefer Qianfan/Ollama vision; Firecrawl OCR only if vision unset or:
# CORPORATE_ALLOW_FIRECRAWL_OCR=1
# Linux GPU: vllm serve baidu/Qianfan-OCR --port 8000
# QIANFAN_OCR_BASE_URL=http://127.0.0.1:8000/v1
# QIANFAN_OCR_MODEL=baidu/Qianfan-OCR

# Optional
# PORT=3000
