# Copy to .env.local (never commit .env.local)

# LLM — cheapest default: local Ollama 3B (no API cost)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b-instruct
# Dual Extract: TX=pdf-parse; PPT=vision OCR when QIANFAN_OCR_BASE_URL set.
# CONCALL_PPT_OCR=0 to force pdf-parse for PPT.
LLM_MODEL_OCR=glm-ocr
# Highlights / orderbook analyse (Mistral)
# LLM_MODEL_HIGHLIGHTS=mistral:7b-instruct
# Orderbook: OCR extract when QIANFAN_OCR_BASE_URL set; analyse via Mistral.
# ORDERBOOK_OCR=0 to force pdf-parse first. Optional override:
# LLM_MODEL_ORDERBOOK=mistral:7b-instruct
# ORDERBOOK_OCR_MAX_PAGES=12
# MarketIQ announcements: pdf-parse first (fast); OCR only if little text.
# Lab "Extract" skips OCR. Set MARKETIQ_OCR=0 to disable OCR fallback entirely.
# LLM_MODEL_MARKETIQ=mistral:7b-instruct
# MARKETIQ_OCR_MAX_PAGES=12
# MARKETIQ_OCR=0
# ollama pull glm-ocr && ollama pull qwen2.5:3b-instruct && ollama pull mistral:7b-instruct

# Cloud LLMs (optional; only when LLM_PROVIDER=openai|anthropic)
# Prefer gpt-4o-mini / claude-haiku if you must use cloud
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Firecrawl — PDF/DOCX parse for concalls and investor materials
# https://docs.firecrawl.dev/features/parse
FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=https://api.firecrawl.dev
# FIRECRAWL_MAX_PAGES=80
# FIRECRAWL_PDF_MODE=auto   # auto | fast | ocr

# Corporate data — scanned PDFs (page images → vision OCR)
# On Mac: use Ollama vision (vLLM is Linux+NVIDIA only)
#   ollama pull qwen2.5vl:3b
# QIANFAN_OCR_BASE_URL=http://127.0.0.1:11434/v1
# QIANFAN_OCR_MODEL=qwen2.5vl:3b
# Prefer Qianfan/Ollama vision; Firecrawl OCR only if vision unset or:
# CORPORATE_ALLOW_FIRECRAWL_OCR=1
# Linux GPU: vllm serve baidu/Qianfan-OCR --port 8000
# QIANFAN_OCR_BASE_URL=http://127.0.0.1:8000/v1
# QIANFAN_OCR_MODEL=baidu/Qianfan-OCR

# Optional
# PORT=3000
