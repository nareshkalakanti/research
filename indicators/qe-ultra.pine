//@version=5
// QE Ultra — Quarterly Earnings table + price bands + SMAs
// Inspired by the QE Ultra 7.1 Inputs surface (FQ/FY table, circuit labels, header meta).
indicator("QE Ultra 7.1", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 200)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS — QE ULTRA
// ═══════════════════════════════════════════════════════════════════════════
GRP_ULTRA = "QE ULTRA"
showQeTable     = input.bool(true,  "Show Quarterly Earning Pro Table", group = GRP_ULTRA)
showEstTable    = input.bool(false, "Show EPS & Sales Estimation Table", group = GRP_ULTRA)
showPriceBand   = input.bool(true,  "Show Price Band informations", inline = "pb", group = GRP_ULTRA)
pbStyle         = input.string("Plot Shapes", "", options = ["Plot Shapes", "Lines", "Both", "None"], inline = "pb", group = GRP_ULTRA)
earnColor       = input.color(color.new(#9C27B0, 0), "", inline = "earn", group = GRP_ULTRA)
showEarnLine    = input.bool(true,  "Earnings line", inline = "earn", group = GRP_ULTRA)
showEarnLabel   = input.bool(true,  "Earnings label", inline = "earn", group = GRP_ULTRA)
darkMode        = input.bool(false, "Dark Mode", tooltip = "Use dark-theme up/down/unchanged colors for the QE table.", group = GRP_ULTRA)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS — PRICE BAND · CIRCUIT LABEL
// ═══════════════════════════════════════════════════════════════════════════
GRP_PB_LBL = "PRICE BAND - CIRCUIT LABEL"
showPastRev     = input.bool(true,  "Display past revisions", inline = "prev", group = GRP_PB_LBL)
pastRevSize     = input.string("Small", "Size", options = ["Tiny", "Small", "Normal", "Large"], inline = "prev", group = GRP_PB_LBL)
showLatestBand  = input.bool(true,  "Display latest price band", group = GRP_PB_LBL)
bandLblSize     = input.string("small", "", options = ["tiny", "small", "normal", "large"], inline = "bandpos", group = GRP_PB_LBL)
bandVAlign      = input.string("top", "", options = ["top", "middle", "bottom"], inline = "bandpos", group = GRP_PB_LBL)
bandHAlign      = input.string("right", "", options = ["left", "center", "right"], inline = "bandpos", group = GRP_PB_LBL)
circuitPct      = input.float(5.0, "Circuit % (NSE band)", minval = 0.5, maxval = 40, step = 0.5, tooltip = "NSE upper/lower circuit as % of previous close. Adjust per stock (2 / 5 / 10 / 20).", group = GRP_PB_LBL)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS — PRICE BAND · UPPER & LOWER CIRCUIT
// ═══════════════════════════════════════════════════════════════════════════
GRP_PB_CIR = "PRICE BAND - UPPER & LOWER CIRCUIT"
showCircuitRange = input.bool(false, "Display Circuit Range", tooltip = "Draw upper/lower circuit lines from previous close ± circuit %.", group = GRP_PB_CIR)
circuitWidth     = input.int(2, "Width", minval = 1, maxval = 5, group = GRP_PB_CIR)
circuitSize      = input.string("Small", "Size", options = ["Tiny", "Small", "Normal", "Large"], group = GRP_PB_CIR)
upperCirColor    = input.color(color.new(#2196F3, 0), "Upper circuit Color", group = GRP_PB_CIR)
lowerCirColor    = input.color(color.new(#F44336, 0), "Lower circuit Color", group = GRP_PB_CIR)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS — QE MODES
// ═══════════════════════════════════════════════════════════════════════════
GRP_MODE = "QE MODES"
qePeriod     = input.string("FQ", "Quarterly (FQ) or Yearly (FY) Data?", options = ["FQ", "FY"], tooltip = "FQ = fiscal quarter rows. FY = fiscal year rows.", group = GRP_MODE)
qeRows       = input.int(4, "Number of rows to display?", minval = 1, maxval = 20, tooltip = "How many historical FQ/FY rows to keep in the table.", group = GRP_MODE)
usePat       = input.bool(false, "Display PAT in place of EPS", tooltip = "Show net income (PAT) instead of EPS in the earnings column.", group = GRP_MODE)
solidBg      = input.bool(false, "Enable Solid backgrounds", tooltip = "Opaque cell backgrounds instead of translucent.", group = GRP_MODE)
miniMode     = input.bool(false, "Mini Mode", tooltip = "Compact table: fewer columns / smaller header.", group = GRP_MODE)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS — QE DISPLAY OPTIONS FOR HEADER ROWS
// ═══════════════════════════════════════════════════════════════════════════
GRP_HDR = "QE DISPLAY OPTIONS FOR HEADER ROWS"
showHeaderRows   = input.bool(true,  "Display Header rows", tooltip = "Show meta header (name / listing / ROE) above the data table.", group = GRP_HDR)
showHdrName      = input.bool(false, "Display name in Header row", group = GRP_HDR)
showHdrListing   = input.bool(true,  "Display listing date in Header row", group = GRP_HDR)
showHdrRoe       = input.bool(true,  "Display ROE in Header row", group = GRP_HDR)
emptyHdrLine     = input.bool(false, "Empty line in Header", group = GRP_HDR)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS — QE COLUMN OPTIONS FOR FQ MODE
// ═══════════════════════════════════════════════════════════════════════════
GRP_FQ = "QE COLUMN OPTIONS FOR FQ MODE"
showQoQ   = input.bool(true, "Display QoQ", group = GRP_FQ)
showYoY   = input.bool(true, "Display YoY", group = GRP_FQ)
showOpm   = input.bool(true, "Display OPM%", group = GRP_FQ)
showPe    = input.bool(true, "Display P/E", group = GRP_FQ)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS — QE COLUMN OPTIONS FOR FY MODE
// ═══════════════════════════════════════════════════════════════════════════
GRP_FY = "QE COLUMN OPTIONS FOR FY MODE"
fySlim = input.bool(false, "Display only EPS, Sales & YoY columns in FY mode", group = GRP_FY)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS — QE TABLE OPTIONS
// ═══════════════════════════════════════════════════════════════════════════
GRP_TBL = "QE TABLE OPTIONS"
tblSize   = input.string("small", "Size", options = ["tiny", "small", "normal", "large"], group = GRP_TBL)
tblVAlign = input.string("bottom", "", options = ["top", "middle", "bottom"], inline = "tblpos", group = GRP_TBL)
tblHAlign = input.string("right", "", options = ["left", "center", "right"], inline = "tblpos", group = GRP_TBL)
estVAlign = input.string("bottom", "Estimates V", options = ["top", "middle", "bottom"], inline = "estpos", group = GRP_TBL)
estHAlign = input.string("center", "Estimates H", options = ["left", "center", "right"], inline = "estpos", group = GRP_TBL)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS — QE COLOR OPTIONS
// ═══════════════════════════════════════════════════════════════════════════
GRP_COL = "QE COLOR OPTIONS"
ltUp   = input.color(color.new(#2196F3, 0), "Light Up Color", group = GRP_COL)
ltDn   = input.color(color.new(#E91E63, 0), "Light Down Color", group = GRP_COL)
ltFlat = input.color(color.new(#FF9800, 70), "Light Unchanged Color", group = GRP_COL)
dkUp   = input.color(color.new(#4CAF50, 0), "Dark Up Color", group = GRP_COL)
dkDn   = input.color(color.new(#F44336, 0), "Dark Down Color", group = GRP_COL)
dkFlat = input.color(color.new(#9E9E9E, 70), "Dark Unchanged Color", group = GRP_COL)
hdrBg  = input.color(color.new(#263238, 20), "Header background", group = GRP_COL)
hdrFg  = input.color(color.white, "Header text", group = GRP_COL)
cellFg = input.color(color.black, "Cell text", group = GRP_COL)

// ═══════════════════════════════════════════════════════════════════════════
// INPUTS — SMAs
// ═══════════════════════════════════════════════════════════════════════════
GRP_SMA = "MOVING AVERAGES"
showSma5   = input.bool(true, "SMA 5", inline = "s1", group = GRP_SMA)
colSma5    = input.color(color.new(#00BCD4, 0), "", inline = "s1", group = GRP_SMA)
showSma10a = input.bool(true, "SMA 10", inline = "s2", group = GRP_SMA)
colSma10a  = input.color(color.new(#4CAF50, 0), "", inline = "s2", group = GRP_SMA)
showSma20  = input.bool(true, "SMA 20", inline = "s3", group = GRP_SMA)
colSma20   = input.color(color.new(#8BC34A, 0), "", inline = "s3", group = GRP_SMA)
showSma40  = input.bool(true, "SMA 40", inline = "s4", group = GRP_SMA)
colSma40   = input.color(color.new(#CDDC39, 0), "", inline = "s4", group = GRP_SMA)
showSma50  = input.bool(true, "SMA 50", inline = "s5", group = GRP_SMA)
colSma50   = input.color(color.new(#FFC107, 0), "", inline = "s5", group = GRP_SMA)
showSma100 = input.bool(true, "SMA 100", inline = "s6", group = GRP_SMA)
colSma100  = input.color(color.new(#FF9800, 0), "", inline = "s6", group = GRP_SMA)
showSma200 = input.bool(true, "SMA 200", inline = "s7", group = GRP_SMA)
colSma200  = input.color(color.new(#FF5722, 0), "", inline = "s7", group = GRP_SMA)
showSma10b = input.bool(false, "SMA 10 (alt)", inline = "s8", group = GRP_SMA)
colSma10b  = input.color(color.new(#9C27B0, 0), "", inline = "s8", group = GRP_SMA)

// ═══════════════════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════════════════
f_size(string s) =>
    sl = str.lower(s)
    sl == "tiny" ? size.tiny : sl == "normal" ? size.normal : sl == "large" ? size.large : size.small

f_tbl_pos(string v, string h) =>
    key = v + "_" + h
    switch key
        "top_left" => position.top_left
        "top_center" => position.top_center
        "top_right" => position.top_right
        "middle_left" => position.middle_left
        "middle_center" => position.middle_center
        "middle_right" => position.middle_right
        "bottom_left" => position.bottom_left
        "bottom_center" => position.bottom_center
        => position.bottom_right

f_txt_size(string s) =>
    switch s
        "tiny" => size.tiny
        "normal" => size.normal
        "large" => size.large
        => size.small

f_fmt(float v, int d) =>
    na(v) ? "—" : d == 0 ? str.tostring(v, "#") : d == 1 ? str.tostring(v, "#.#") : str.tostring(v, "#.##")

f_fmt_pct(float v) =>
    na(v) ? "—" : str.tostring(v, "#.#") + "%"

f_fmt_cr(float v) =>
    // Sales / PAT shown in ₹ Cr (÷ 1e7)
    na(v) ? "—" : str.tostring(v / 1e7, "#.#")

f_chg_bg(float cur, float prv) =>
    up = darkMode ? dkUp : ltUp
    dn = darkMode ? dkDn : ltDn
    flat = darkMode ? dkFlat : ltFlat
    transp = solidBg ? 0 : 55
    base = na(cur) or na(prv) or cur == prv ? flat : cur > prv ? up : dn
    color.new(base, transp)

f_month_label(int t) =>
    m = month(t)
    y = year(t) % 100
    mon = switch m
        1 => "Jan"
        2 => "Feb"
        3 => "Mar"
        4 => "Apr"
        5 => "May"
        6 => "Jun"
        7 => "Jul"
        8 => "Aug"
        9 => "Sep"
        10 => "Oct"
        11 => "Nov"
        => "Dec"
    mon + "'" + str.tostring(y)

// ═══════════════════════════════════════════════════════════════════════════
// FINANCIALS
// ═══════════════════════════════════════════════════════════════════════════
period = qePeriod

epsRaw   = request.financial(syminfo.tickerid, "EARNINGS_PER_SHARE_BASIC", period, ignore_invalid_symbol = true)
patRaw   = request.financial(syminfo.tickerid, "NET_INCOME", period, ignore_invalid_symbol = true)
salesRaw = request.financial(syminfo.tickerid, "TOTAL_REVENUE", period, ignore_invalid_symbol = true)
opIncRaw = request.financial(syminfo.tickerid, "OPERATING_INCOME", period, ignore_invalid_symbol = true)
roeRaw   = request.financial(syminfo.tickerid, "RETURN_ON_EQUITY", "FY", ignore_invalid_symbol = true)
epsTtm   = request.financial(syminfo.tickerid, "EARNINGS_PER_SHARE_BASIC", "TTM", ignore_invalid_symbol = true)

// Estimates (best-effort; many NSE names have sparse coverage)
epsEst   = request.financial(syminfo.tickerid, "EARNINGS_PER_SHARE_BASIC", "FQ", gaps = barmerge.gaps_on, ignore_invalid_symbol = true)
salesEst = request.financial(syminfo.tickerid, "TOTAL_REVENUE", "FQ", gaps = barmerge.gaps_on, ignore_invalid_symbol = true)

earnMetric = usePat ? patRaw : epsRaw
opmRaw = not na(salesRaw) and salesRaw != 0 and not na(opIncRaw) ? opIncRaw / salesRaw * 100.0 : na

// Collect period snapshots when the primary metric changes
var float[] aEarn  = array.new_float()
var float[] aSales = array.new_float()
var float[] aOpm   = array.new_float()
var int[]   aTime  = array.new_int()

// Keep extra history so YoY (FQ needs +4) still works when the table shows fewer rows
histKeep = qePeriod == "FQ" ? math.max(qeRows + 4, 8) : math.max(qeRows + 1, 4)

pushPeriod() =>
    array.unshift(aEarn, earnMetric)
    array.unshift(aSales, salesRaw)
    array.unshift(aOpm, opmRaw)
    array.unshift(aTime, time)
    while array.size(aEarn) > histKeep
        array.pop(aEarn)
        array.pop(aSales)
        array.pop(aOpm)
        array.pop(aTime)

newPeriod = not na(earnMetric) and (array.size(aEarn) == 0 or earnMetric != array.get(aEarn, 0) or (not na(salesRaw) and not na(array.get(aSales, 0)) and salesRaw != array.get(aSales, 0)))
if barstate.isconfirmed and newPeriod
    pushPeriod()

// First fill + keep latest row live
if barstate.islast and array.size(aEarn) == 0 and not na(earnMetric)
    pushPeriod()
if barstate.islast and array.size(aEarn) > 0
    array.set(aEarn, 0, earnMetric)
    array.set(aSales, 0, salesRaw)
    array.set(aOpm, 0, opmRaw)
    array.set(aTime, 0, time)

peVal = not na(epsTtm) and epsTtm != 0 ? close / epsTtm : na

// ═══════════════════════════════════════════════════════════════════════════
// EARNINGS MARKERS
// ═══════════════════════════════════════════════════════════════════════════
earnEvent = not na(earnMetric) and ta.change(earnMetric) != 0
plot(showEarnLine and earnEvent ? close : na, title = "Earnings line", color = earnColor, style = plot.style_linebr, linewidth = 2)
if showEarnLabel and earnEvent
    label.new(bar_index, high, "E", style = label.style_label_down, color = earnColor, textcolor = color.white, size = size.tiny)

// ═══════════════════════════════════════════════════════════════════════════
// PRICE BANDS / CIRCUITS
// ═══════════════════════════════════════════════════════════════════════════
prevClose = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_on)
upperCir = prevClose * (1.0 + circuitPct / 100.0)
lowerCir = prevClose * (1.0 - circuitPct / 100.0)

plot(showPriceBand and showCircuitRange and (pbStyle == "Lines" or pbStyle == "Both") ? upperCir : na, "Upper Circuit", color = upperCirColor, linewidth = circuitWidth, style = plot.style_linebr)
plot(showPriceBand and showCircuitRange and (pbStyle == "Lines" or pbStyle == "Both") ? lowerCir : na, "Lower Circuit", color = lowerCirColor, linewidth = circuitWidth, style = plot.style_linebr)

hitUpper = showPriceBand and (pbStyle == "Plot Shapes" or pbStyle == "Both") and high >= upperCir
hitLower = showPriceBand and (pbStyle == "Plot Shapes" or pbStyle == "Both") and low <= lowerCir
plotshape(hitUpper, title = "Upper circuit hit", style = shape.triangledown, location = location.abovebar, color = upperCirColor, size = f_size(circuitSize))
plotshape(hitLower, title = "Lower circuit hit", style = shape.triangleup, location = location.belowbar, color = lowerCirColor, size = f_size(circuitSize))

// Latest + past revision labels (daily timeframe snapshots)
var label latestBandLbl = na
if showPriceBand and showLatestBand and barstate.islast and not na(prevClose)
    if not na(latestBandLbl)
        label.delete(latestBandLbl)
    txt = "UC " + str.tostring(upperCir, format.mintick) + "\nLC " + str.tostring(lowerCir, format.mintick) + "\n(" + str.tostring(circuitPct, "#.#") + "%)"
    y = bandVAlign == "top" ? high : bandVAlign == "bottom" ? low : close
    sty = bandHAlign == "left" ? label.style_label_right : bandHAlign == "right" ? label.style_label_left : label.style_label_center
    latestBandLbl := label.new(bar_index, y, txt, style = sty, color = color.new(upperCirColor, 70), textcolor = color.white, size = f_txt_size(bandLblSize))

// Past circuit touches (proxy for band “revisions” — TV has no NSE band-revision feed)
if showPriceBand and showPastRev and not barstate.islast and not na(upperCir)
    if high >= upperCir
        label.new(bar_index, high, "UC " + str.tostring(upperCir, format.mintick), style = label.style_none, textcolor = upperCirColor, size = f_size(pastRevSize))
    if low <= lowerCir
        label.new(bar_index, low, "LC " + str.tostring(lowerCir, format.mintick), style = label.style_none, textcolor = lowerCirColor, size = f_size(pastRevSize))

// ═══════════════════════════════════════════════════════════════════════════
// SMAs
// ═══════════════════════════════════════════════════════════════════════════
plot(showSma5   ? ta.sma(close, 5)   : na, "SMA 5",   color = colSma5,   linewidth = 1)
plot(showSma10a ? ta.sma(close, 10)  : na, "SMA 10",  color = colSma10a, linewidth = 1)
plot(showSma20  ? ta.sma(close, 20)  : na, "SMA 20",  color = colSma20,  linewidth = 1)
plot(showSma40  ? ta.sma(close, 40)  : na, "SMA 40",  color = colSma40,  linewidth = 1)
plot(showSma50  ? ta.sma(close, 50)  : na, "SMA 50",  color = colSma50,  linewidth = 1)
plot(showSma100 ? ta.sma(close, 100) : na, "SMA 100", color = colSma100, linewidth = 1)
plot(showSma200 ? ta.sma(close, 200) : na, "SMA 200", color = colSma200, linewidth = 2)
plot(showSma10b ? ta.sma(close, 10)  : na, "SMA 10 (alt)", color = colSma10b, linewidth = 1)

// ═══════════════════════════════════════════════════════════════════════════
// QE TABLE
// ═══════════════════════════════════════════════════════════════════════════
var table qeTbl = na
var table estTbl = na

if barstate.islast and showQeTable
    useFqCols = qePeriod == "FQ"
    slimFy = qePeriod == "FY" and fySlim

    // Column plan: Period | EPS/PAT | YoY | QoQ | Sales | OPM% | P/E
    cols = 2  // period + earn
    if not miniMode and not slimFy
        if showYoY
            cols += 1
        if useFqCols and showQoQ
            cols += 1
        cols += 1  // sales always (unless mini)
        if showOpm
            cols += 1
        if showPe
            cols += 1
    else if slimFy
        cols += 2  // sales + yoy
    else
        // mini: period + earn + sales
        cols += 1

    hdrExtra = 0
    if showHeaderRows
        if showHdrName
            hdrExtra += 1
        if showHdrListing
            hdrExtra += 1
        if showHdrRoe
            hdrExtra += 1
        if emptyHdrLine
            hdrExtra += 1

    rows = 1 + hdrExtra + math.min(qeRows, math.max(array.size(aEarn), 0))  // col header + meta + data
    if not na(qeTbl)
        table.delete(qeTbl)
    qeTbl := table.new(f_tbl_pos(tblVAlign, tblHAlign), cols, math.max(rows, 2), border_width = 1)

    r = 0
    // Meta header rows
    if showHeaderRows
        if showHdrName
            table.cell(qeTbl, 0, r, syminfo.ticker, text_color = hdrFg, bgcolor = hdrBg, text_size = f_txt_size(tblSize), text_halign = text.align_left)
            for c = 1 to cols - 1
                table.cell(qeTbl, c, r, "", bgcolor = hdrBg)
            table.merge_cells(qeTbl, 0, r, cols - 1, r)
            r += 1
        if showHdrListing
            listTxt = "Listed · " + syminfo.prefix + ":" + syminfo.ticker
            table.cell(qeTbl, 0, r, listTxt, text_color = hdrFg, bgcolor = hdrBg, text_size = f_txt_size(tblSize), text_halign = text.align_left)
            for c = 1 to cols - 1
                table.cell(qeTbl, c, r, "", bgcolor = hdrBg)
            table.merge_cells(qeTbl, 0, r, cols - 1, r)
            r += 1
        if showHdrRoe
            roeTxt = "ROE " + f_fmt_pct(roeRaw)
            table.cell(qeTbl, 0, r, roeTxt, text_color = hdrFg, bgcolor = hdrBg, text_size = f_txt_size(tblSize), text_halign = text.align_left)
            for c = 1 to cols - 1
                table.cell(qeTbl, c, r, "", bgcolor = hdrBg)
            table.merge_cells(qeTbl, 0, r, cols - 1, r)
            r += 1
        if emptyHdrLine
            for c = 0 to cols - 1
                table.cell(qeTbl, c, r, " ", bgcolor = color.new(hdrBg, 80), text_size = f_txt_size(tblSize))
            r += 1

    // Column headers
    earnHdr = usePat ? "PAT" : "EPS"
    col = 0
    table.cell(qeTbl, col, r, qePeriod, text_color = hdrFg, bgcolor = hdrBg, text_size = f_txt_size(tblSize))
    col += 1
    table.cell(qeTbl, col, r, earnHdr, text_color = hdrFg, bgcolor = hdrBg, text_size = f_txt_size(tblSize))
    col += 1
    if not miniMode and not slimFy
        if showYoY
            table.cell(qeTbl, col, r, "YoY", text_color = hdrFg, bgcolor = hdrBg, text_size = f_txt_size(tblSize))
            col += 1
        if useFqCols and showQoQ
            table.cell(qeTbl, col, r, "QoQ", text_color = hdrFg, bgcolor = hdrBg, text_size = f_txt_size(tblSize))
            col += 1
        table.cell(qeTbl, col, r, "Sales", text_color = hdrFg, bgcolor = hdrBg, text_size = f_txt_size(tblSize))
        col += 1
        if showOpm
            table.cell(qeTbl, col, r, "OPM%", text_color = hdrFg, bgcolor = hdrBg, text_size = f_txt_size(tblSize))
            col += 1
        if showPe
            table.cell(qeTbl, col, r, "P/E", text_color = hdrFg, bgcolor = hdrBg, text_size = f_txt_size(tblSize))
    else if slimFy
        table.cell(qeTbl, col, r, "Sales", text_color = hdrFg, bgcolor = hdrBg, text_size = f_txt_size(tblSize))
        col += 1
        table.cell(qeTbl, col, r, "YoY", text_color = hdrFg, bgcolor = hdrBg, text_size = f_txt_size(tblSize))
    else
        table.cell(qeTbl, col, r, "Sales", text_color = hdrFg, bgcolor = hdrBg, text_size = f_txt_size(tblSize))
    r += 1

    nAll = array.size(aEarn)
    nShow = math.min(qeRows, nAll)
    if nShow > 0
        for i = 0 to nShow - 1
            e  = array.get(aEarn, i)
            s  = array.get(aSales, i)
            o  = array.get(aOpm, i)
            t  = array.get(aTime, i)
            // YoY: +4 for FQ, +1 for FY (uses hidden history beyond nShow)
            yoyIdx = qePeriod == "FQ" ? i + 4 : i + 1
            qoqIdx = i + 1
            eYoy = yoyIdx < nAll ? array.get(aEarn, yoyIdx) : na
            eQoq = qoqIdx < nAll ? array.get(aEarn, qoqIdx) : na
            sYoy = yoyIdx < nAll ? array.get(aSales, yoyIdx) : na
            sQoq = qoqIdx < nAll ? array.get(aSales, qoqIdx) : na
            oQoq = qoqIdx < nAll ? array.get(aOpm, qoqIdx) : na
            yoyPct = not na(e) and not na(eYoy) and eYoy != 0 ? (e - eYoy) / math.abs(eYoy) * 100.0 : na
            qoqPct = not na(e) and not na(eQoq) and eQoq != 0 ? (e - eQoq) / math.abs(eQoq) * 100.0 : na
            salesYoyPct = not na(s) and not na(sYoy) and sYoy != 0 ? (s - sYoy) / math.abs(sYoy) * 100.0 : na

            periodLbl = f_month_label(t)
            earnTxt = usePat ? f_fmt_cr(e) : f_fmt(e, 2)

            c = 0
            table.cell(qeTbl, c, r, periodLbl, text_color = cellFg, bgcolor = color.new(hdrBg, 70), text_size = f_txt_size(tblSize))
            c += 1
            table.cell(qeTbl, c, r, earnTxt, text_color = cellFg, bgcolor = f_chg_bg(e, eQoq), text_size = f_txt_size(tblSize))
            c += 1

            if not miniMode and not slimFy
                if showYoY
                    table.cell(qeTbl, c, r, f_fmt_pct(yoyPct), text_color = cellFg, bgcolor = f_chg_bg(yoyPct, 0.0), text_size = f_txt_size(tblSize))
                    c += 1
                if useFqCols and showQoQ
                    table.cell(qeTbl, c, r, f_fmt_pct(qoqPct), text_color = cellFg, bgcolor = f_chg_bg(qoqPct, 0.0), text_size = f_txt_size(tblSize))
                    c += 1
                table.cell(qeTbl, c, r, f_fmt_cr(s), text_color = cellFg, bgcolor = f_chg_bg(s, sQoq), text_size = f_txt_size(tblSize))
                c += 1
                if showOpm
                    table.cell(qeTbl, c, r, f_fmt(o, 1), text_color = cellFg, bgcolor = f_chg_bg(o, oQoq), text_size = f_txt_size(tblSize))
                    c += 1
                if showPe
                    peTxt = i == 0 ? f_fmt(peVal, 1) : "—"
                    table.cell(qeTbl, c, r, peTxt, text_color = cellFg, bgcolor = color.new(ltFlat, solidBg ? 0 : 55), text_size = f_txt_size(tblSize))
            else if slimFy
                table.cell(qeTbl, c, r, f_fmt_cr(s), text_color = cellFg, bgcolor = f_chg_bg(s, sYoy), text_size = f_txt_size(tblSize))
                c += 1
                table.cell(qeTbl, c, r, f_fmt_pct(salesYoyPct), text_color = cellFg, bgcolor = f_chg_bg(salesYoyPct, 0.0), text_size = f_txt_size(tblSize))
            else
                table.cell(qeTbl, c, r, f_fmt_cr(s), text_color = cellFg, bgcolor = f_chg_bg(s, sQoq), text_size = f_txt_size(tblSize))
            r += 1

if barstate.islast and not showQeTable and not na(qeTbl)
    table.delete(qeTbl)
    qeTbl := na

// Estimation table (best-effort latest values)
if barstate.islast and showEstTable
    if not na(estTbl)
        table.delete(estTbl)
    estTbl := table.new(f_tbl_pos(estVAlign, estHAlign), 3, 3, border_width = 1)
    table.cell(estTbl, 0, 0, "Estimates", text_color = hdrFg, bgcolor = hdrBg, text_size = f_txt_size(tblSize))
    table.cell(estTbl, 1, 0, "EPS", text_color = hdrFg, bgcolor = hdrBg, text_size = f_txt_size(tblSize))
    table.cell(estTbl, 2, 0, "Sales", text_color = hdrFg, bgcolor = hdrBg, text_size = f_txt_size(tblSize))
    table.cell(estTbl, 0, 1, "Latest FQ", text_color = cellFg, bgcolor = color.new(hdrBg, 70), text_size = f_txt_size(tblSize))
    table.cell(estTbl, 1, 1, f_fmt(epsEst, 2), text_color = cellFg, bgcolor = color.new(ltFlat, 55), text_size = f_txt_size(tblSize))
    table.cell(estTbl, 2, 1, f_fmt_cr(salesEst), text_color = cellFg, bgcolor = color.new(ltFlat, 55), text_size = f_txt_size(tblSize))
    table.cell(estTbl, 0, 2, "Note", text_color = cellFg, bgcolor = color.new(hdrBg, 70), text_size = f_txt_size(tblSize))
    table.merge_cells(estTbl, 1, 2, 2, 2)
    table.cell(estTbl, 1, 2, "TV fundamentals; estimates sparse on NSE", text_color = cellFg, bgcolor = color.new(ltFlat, 70), text_size = f_txt_size(tblSize))

if barstate.islast and not showEstTable and not na(estTbl)
    table.delete(estTbl)
    estTbl := na
